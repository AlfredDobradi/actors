<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account List</title>
</head>
<body>
    <h2>Account list</h2>
    <table>
        <tr>
            <td>ID</td>
            <td>Username</td>
            <td>Email</td>
            <td>Created At</td>
            <td>Updated At</td>
            <td>Active</td>
        </tr>
    {{ range .Accounts }}
        <tr>
            <td><a href="/accounts/{{ .ID }}" target="_blank">{{ .ID }}</a></td>
            <td>{{ .Username }}</td>
            <td>{{ .Email }}</td>
            <td>{{ .CreatedAt }}</td>
            <td>{{ .UpdatedAt }}</td>
            <td>{{ .Active }}</td>
        </tr>
    {{ end }}
    </table>
</body>
</html>